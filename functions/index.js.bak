import { onRequest } from "firebase-functions/v2/https";
import { defineSecret } from "firebase-functions/params";

const GOOGLE_API_KEY = defineSecret("GOOGLE_API_KEY");

// PHOTO PROXY
export const getPhoto = onRequest(
  { secrets: [GOOGLE_API_KEY] },
  async (req, res) => {
    try {
      const ref = req.query.ref;
      const key = GOOGLE_API_KEY.value();

      const url = `https://maps.googleapis.com/maps/api/place/photo?maxwidth=800&photo_reference=${ref}&key=${key}`;

      const r = await fetch(url);
      const buffer = await r.arrayBuffer();

      res.set("Content-Type", r.headers.get("content-type"));
      res.send(Buffer.from(buffer));
    } catch (e) {
      res.status(500).send("Photo failed");
    }
  }
);

// MAIN
export const getIdeas = onRequest(
  { region: "us-central1", secrets: [GOOGLE_API_KEY] },
  async (req, res) => {
    try {
      const data = req.method === "GET" ? req.query : req.body;

      const lat = parseFloat(data?.lat) || 30.8;
      const lng = parseFloat(data?.lng) || -81.7;
      const isDateNight =
        data?.isDateNight === "true" || data?.isDateNight === true;

      const key = GOOGLE_API_KEY.value();

      // 🔥 BETTER QUERIES
      const foodRes = await fetch(
        `https://maps.googleapis.com/maps/api/place/textsearch/json?query=restaurant&location=${lat},${lng}&radius=30000&key=${key}`
      );

      const expRes = await fetch(
        `https://maps.googleapis.com/maps/api/place/textsearch/json?query=things to do&location=${lat},${lng}&radius=30000&key=${key}`
      );

      const foodData = await foodRes.json();
      const expData = await expRes.json();

      // 🔥 FILTER BAD RESULTS
      const goodFood = foodData.results.filter(
        p => (p.rating || 0) >= 4.2 && p.user_ratings_total > 50
      );

      const goodExp = expData.results.filter(
        p =>
          (p.rating || 0) >= 4.2 &&
          !p.types.includes("park") &&
          !p.types.includes("locality")
      );

      const food = goodFood[0];
      const exp = goodExp.find(p => p.place_id !== food.place_id);

      const base =
        "https://us-central1-decide-for-us-792bc.cloudfunctions.net/getPhoto";

      return res.json([
        {
          id: food.place_id,
          title: `${food.name} → ${exp.name}`,
          description: isDateNight
            ? `Start with ${food.name} for an elevated dining experience, then continue into ${exp.name} for something memorable.`
            : `Start with ${food.name}, then head to ${exp.name}.`,
          address: food.formatted_address,
          lat: food.geometry.location.lat,
          lng: food.geometry.location.lng,
          photoUrl: food.photos?.[0]
            ? `${base}?ref=${food.photos[0].photo_reference}`
            : null,
        },
        {
          id: exp.place_id + "_alt",
          title: `${exp.name} → ${food.name}`,
          description: isDateNight
            ? `Begin at ${exp.name}, then finish strong at ${food.name}.`
            : `Start at ${exp.name}, then wind down at ${food.name}.`,
          address: exp.formatted_address,
          lat: exp.geometry.location.lat,
          lng: exp.geometry.location.lng,
          photoUrl: exp.photos?.[0]
            ? `${base}?ref=${exp.photos[0].photo_reference}`
            : null,
        }
      ]);
    } catch (err) {
      return res.json([
        {
          id: "fallback",
          title: "Try Again Nearby",
          description: "We couldn’t load ideas right now. Try again.",
          address: "",
          lat: 0,
          lng: 0,
          photoUrl: null,
        }
      ]);
    }
  }
);